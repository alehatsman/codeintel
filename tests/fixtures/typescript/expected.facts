def_doc("local app/app.ts start().", "Start up. `open` is defined twice repo-wide, so only tier B resolves it.").
def_doc("local db/conn.ts open().", "The database layer. Nothing here may import from ui/.").
def_doc("local kinds.ts Config#", "A class, with a documented field and a documented method.\n\nTwo lines of documentation, to prove newlines survive.").
def_doc("local kinds.ts Config#limit.", "The limit.").
def_doc("local kinds.ts Handler#", "A documented interface.").
def_doc("local kinds.ts Handler#handle().", "Handle one key.").
def_doc("local kinds.ts describe().", "An arrow binding is a function, so `calls` can reach it.").
def_doc("local net/conn.ts open().", "A second connection layer, exporting a function with the same name as\ndb/conn's. That ambiguity is the whole point: tier A cannot decide which\n`open` a caller in a third file means, and gives up rather than guessing.").
def_doc("local store/store.test.ts testWarm().", "A test file, so is_test(F) has something to match on by path.").
def_doc("local store/store.ts Entry#", "One entry in the store.").
def_doc("local store/store.ts Store#", "A tiny key-value store, implementing an interface from another file.").
def_doc("local store/store.ts Store#get().", "Read one entry.\n\nTwo lines of documentation, to prove newlines survive.").
def_doc("local store/store.ts warm().", "A free function that calls a method, so `calls` has an edge to find.").
def_doc("local ui/row.tsx Row().", "A component, so a JSX tag has something to be a use of.").
