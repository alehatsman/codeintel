% A hand-written fact set for a small polyglot repo: Rust with a SCIP index,
% Go and TypeScript with tree-sitter only. Written for the M1 agent eval
% (docs/agent-eval.md), so it is realistic rather than minimal — mixed
% provenance, one ambiguous name, two dead exports, an extern package, a trait
% with two implementors, and tests that call into the code under test.
%
% Nothing here comes from an extractor. Every row is a fact a real index would
% hold, written by hand so the eval tests the schema and the language rather
% than the extractors.

% === files =============================================================
file("src/lib.rs", "rust").
file("src/store.rs", "rust").
file("src/cache.rs", "rust").
file("src/api.rs", "rust").
file("tests/store_test.rs", "rust").
file("cmd/server/main.go", "go").
file("web/app.ts", "typescript").
file("web/app.test.ts", "typescript").

% === definitions =======================================================
% Rust: resolved by SCIP, so the SymId is the SCIP symbol string.
def("scip demo store/Backend#", "src/store.rs", "trait", "Backend").
def("scip demo store/Store#", "src/store.rs", "struct", "Store").
def("scip demo store/Store#get().", "src/store.rs", "method", "get").
def("scip demo store/Store#put().", "src/store.rs", "method", "put").
def("scip demo store/Store#evict().", "src/store.rs", "method", "evict").
def("scip demo store/open().", "src/store.rs", "function", "open").
def("scip demo cache/Cache#", "src/cache.rs", "struct", "Cache").
def("scip demo cache/Cache#warm().", "src/cache.rs", "method", "warm").
def("scip demo cache/hash().", "src/cache.rs", "function", "hash").
def("scip demo api/handle_read().", "src/api.rs", "function", "handle_read").
def("scip demo api/handle_write().", "src/api.rs", "function", "handle_write").
def("scip demo lib/init().", "src/lib.rs", "function", "init").
def("scip demo tests/test_get().", "tests/store_test.rs", "function", "test_get").
def("scip demo tests/test_put().", "tests/store_test.rs", "function", "test_put").

% Go and TypeScript: tree-sitter only, so the SymId is path-keyed.
def("local cmd/server/main.go Server#", "cmd/server/main.go", "struct", "Server").
def("local cmd/server/main.go Server#Start().", "cmd/server/main.go", "method", "Start").
def("local cmd/server/main.go serve().", "cmd/server/main.go", "function", "serve").
def("local cmd/server/main.go main().", "cmd/server/main.go", "function", "main").
def("local cmd/server/main.go init().", "cmd/server/main.go", "function", "init").
def("local web/app.ts App#", "web/app.ts", "class", "App").
def("local web/app.ts App#render().", "web/app.ts", "method", "render").
def("local web/app.ts boot().", "web/app.ts", "function", "boot").
def("local web/app.test.ts test_render().", "web/app.test.ts", "function", "test_render").

