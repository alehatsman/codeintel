def_doc("local app/app.go Start().", "Start starts up.").
def_doc("local db/conn.go Open().", "Open opens a connection.").
def_doc("local kinds.go Banner.", "Banner is a package-level variable.").
def_doc("local kinds.go Config#", "Config is a struct, with a documented field.").
def_doc("local kinds.go Config#Handle().", "Handle satisfies Handler. Its receiver is the only thing that says so: the\nmethod is lexically at file scope and semantically owned by Config.").
def_doc("local kinds.go Config#Limit.", "Limit is how many entries to keep.").
def_doc("local kinds.go Config#describe().", "describe is unexported, so `exported` must not hold for it.").
def_doc("local kinds.go Handler#", "Handler is an interface, so a method with no body has somewhere to live.").
def_doc("local kinds.go Handler#Handle().", "Handle is the required method.").
def_doc("local kinds.go Key#", "Key is a type alias.").
def_doc("local kinds.go Limit.", "Limit is a constant.").
def_doc("local kinds.go Mode#", "Mode is a defined type over a builtin. Distinct from an alias, which is the\nwhole point: `type Mode int` introduces a new type and `type Key = string`\ndoes not.").
def_doc("local net/conn.go Open().", "Open opens a socket.").
def_doc("local store/store.go Entry#", "Entry is one entry in the store.").
def_doc("local store/store.go Entry#Describe().", "Describe renders an entry. A second type with methods in the same file, so\nthat resolving a receiver to the wrong one would show up.").
def_doc("local store/store.go Store#", "Store is a tiny key-value store.").
def_doc("local store/store.go Store#Get().", "Get reads one entry.\n\nTwo lines of documentation, to prove newlines survive.").
def_doc("local store/store.go Store#Put().", "Put writes one entry. A value receiver where Get took a pointer one, so the\nowner is found through both spellings.").
def_doc("local store/store.go Warm().", "Warm is a free function that calls a method, so `calls` has an edge to find.").
def_doc("local ui/panel.go Draw().", "Draw draws the panel.").
