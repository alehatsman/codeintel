% codeintel standard library.
%
% Every rule here is derived from the base relations in specs/01-facts.md.
% A new structural question is a rule in this file — not a function, not a CLI
% verb, not an MCP tool. That is the mechanism that keeps this project small.
%
% Two conventions run through the whole file:
%   * Seeded traversals take the seed FIRST (impact_of, reach_of). The engine
%     pushes that binding into the recursion, so evaluation grows outward from
%     the seed instead of computing all-pairs reachability.
%   * Anything reading `calls` or `ref` is contaminated by resolution quality,
%     so it ships in both forms: the `name`-tolerant one and the `_exact` one
%     that gates on SCIP evidence.

% === visibility ========================================================
% `exported` is DERIVED. The extractor records what a definition SAYS about
% itself (`visibility`); whether that makes it visible outside the crate is a
% question about its ancestors, which is a join and not a token.

%% exported(S)  S is visible outside its crate.
exported(S) :- visibility(S, "public").

% An enum variant, a trait item and a trait-impl method have nowhere to write
% `pub`, so they are as visible as whatever owns them. Recursive, so a variant
% of a public enum inside a public module needs no special case and depth is
% not capped. A trait-impl method reaches its answer through `parent`, which is
% the TYPE: a `pub` trait implemented for a private type gives methods nobody
% outside can name, and calling those exported would make `dead_export` demand
% documentation for unreachable code.
exported(S) :- visibility(S, "inherited"), parent(S, P), exported(P).

% A TypeScript `export { x }` or `export default x` is a clause the declaration
% never sees, so `visibility` says `restricted` and this row says exported. Same
% file, local name; the alias in `f as g` is not recorded (01-facts.md
% § `name_export`).
exported(S) :- name_export(F, N), def(S, F, _, N).

% `restricted` appears in no rule, and that is the point: `pub(crate)` and a
% bare `fn` are both "not visible outside the crate", which is exactly the
% question `exported` asks.

% === implements ========================================================
% Also DERIVED, for the reason `ref` is: tier B states it exactly when the
% indexer bothers to — rust-analyzer never does — and tier A can state it by
% name from one file's syntax.

%% implements(S, T, Prov)  S implements or overrides T.
implements(S, T, "exact") :- scip_impl(S, T).

% Tier A resolves both written names with the policy `ref` uses, reusing
% `local_def` and `ambiguous` below. The guard is per-PAIR: `scip_impl` is
% method-level where an indexer emits it at all and `name_impl` is type-level,
% so they are different granularities and both rows are true.
implements(S, T, "name") :-
    name_impl(F, TypeN, TraitN, _),
    impl_sym(F, TypeN, S), impl_sym(F, TraitN, T), !scip_impl(S, T).

%% impl_sym(F, N, S)  a name an `impl` writes, as a symbol.
% Four clauses: either side of the `for`, each resolved same-file-first. The
% leading `name_impl` binds F and N POSITIVELY, which is what makes the negated
% branches safe — a rule whose only binder for a variable is `!local_def(F, N)`
% is rejected by the engine, and that is why `ref` leads with `name_ref` too.
impl_sym(F, N, S) :- name_impl(F, N, _, _), def(S, F, _, N).
impl_sym(F, N, S) :- name_impl(F, _, N, _), def(S, F, _, N).
% else a unique exported definition repo-wide
impl_sym(F, N, S) :- name_impl(F, N, _, _),
    !local_def(F, N), def(S, _, _, N), exported(S), !ambiguous(N).
impl_sym(F, N, S) :- name_impl(F, _, N, _),
    !local_def(F, N), def(S, _, _, N), exported(S), !ambiguous(N).

% === reference resolution ==============================================
% `ref` is DERIVED. Tier B contributes resolved occurrences directly; tier A
% contributes names that these rules resolve against the whole-repo def set.
% To tighten resolution, edit the two `name` rules. To disable tier-A
% resolution entirely, delete them: `ref` degrades to `exact` only.

%% ref(S, F, L, C, From, Role, Prov)  resolved occurrence. Prov says which tier.
ref(S, F, L, C, From, Role, "exact") :- scip_ref(S, F, L, C, From, Role).

% Name matching is a FALLBACK, not a parallel claim: `!scip_ref` restricts it to
% occurrences tier B never resolved, so the tiers partition the positions
% instead of both claiming them (`specs/01-facts.md` § Tier precedence).
% Vacuous without a SCIP index, so tier-A-only output is unchanged.
% same file wins
ref(S, F, L, C, From, "read", "name") :-
    name_ref(N, F, L, C, From), !scip_ref(_, F, L, C, _, _), def(S, F, _, N).

% else a unique exported definition repo-wide
ref(S, F, L, C, From, "read", "name") :-
    name_ref(N, F, L, C, From), !scip_ref(_, F, L, C, _, _), !local_def(F, N),
    def(S, _, _, N), exported(S), !ambiguous(N).

%% local_def(F, N)  the NAME N has a definition in file F. Not a symbol.
local_def(F, N) :- def(S, F, _, N).

% Grouped, not a self-join: the self-join form emits k*k candidate pairs for a
% name with k definitions before dedup, and the aggregate form is free.
% Grouped over NAMES, not def rows: `def(_, _, _, N)` as the outer literal
% binds N once per definition, so the count ran once per row and a name with
% k definitions was counted k times. `named` is a set, so it runs once.
%% named(N)  some definition is named N.
named(N) :- def(_, _, _, N).
%% ambiguous(N)  N names >1 definition, so name matching cannot pick.
ambiguous(N) :- named(N), C = count{ S : def(S, _, _, N) }, C > 1.

% === the location bridge ===============================================
% Turns a file:line from ripgrep, git diff, a stack trace or a compiler error
% into a symbol. This is how anything gets INTO the graph.
%
% `between` GENERATES when its first two arguments are bound, so Line appears
% in a positive body literal and the rule is unconditionally safe. Written with
% bare comparisons instead, Line would be bound by nothing and the engine would
% reject its own standard library.

%% symbol_at(F, Line, S)  every def whose span covers Line. Prefer innermost_at.
symbol_at(F, Line, S) :- def(S, F, _, _), def_span(S, L1, L2, _, _),
                         between(L1, L2, Line).

%% innermost_at(F, Line, S)  location -> tightest enclosing symbol. START HERE.
innermost_at(F, Line, S) :- symbol_at(F, Line, S), !tighter_at(F, Line, S).

% T is strictly tighter than S: compare widths, not endpoints, so two
% definitions sharing an identical span do not cancel each other out and leave
% `innermost_at` empty.
%% tighter_at(F, Line, S)  helper for innermost_at.
tighter_at(F, Line, S) :- symbol_at(F, Line, S), symbol_at(F, Line, T), T != S,
                          def_span(S, A, B, _, _), def_span(T, C, D, _, _),
                          V = B - A, W = D - C, W < V.

% === callability =======================================================
%% callable(Kind)  function | method | constructor | macro.
callable("function").
callable("method").
callable("constructor").
callable("macro").

% === calls: a reference to a callable, attributed to its enclosing def ==
%% calls_at(From, S, F, L, Prov)  one call site, with its line and provenance.
calls_at(From, S, F, L, Prov) :-
    ref(S, F, L, _, From, Role, Prov), Role != "def",
    def(S, _, K, _), callable(K).

%% calls(From, S)  From calls S, either provenance.
calls(From, S) :- calls_at(From, S, _, _, _).
%% calls_exact(From, S)  From calls S, SCIP-resolved only.
calls_exact(From, S) :- calls_at(From, S, _, _, "exact").

% `callers`/`callees` were here until schema 2. Both were `calls/2` verbatim
% with the variables renamed, so they bought an agent nothing it could not ask
% of `calls` directly, and the schema budget is the one that binds. Ask
% `?- calls(C, S)` and bind whichever argument you know.

%% callers_by_name(C, N)  C calls something named N. No SymId needed.
callers_by_name(C, N) :- calls(C, S), def(S, _, _, N).
%% impact_by_name(C, N)  C transitively calls something named N.
impact_by_name(C, N) :- def(S, _, _, N), impact_of(S, C).

% === transitive closure, SEEDED ========================================
% Always prefer these.

%% impact_of(Seed, C)  transitive callers. SEED THE 1st ARG.
impact_of(Seed, C) :- calls(C, Seed).                     % who calls Seed
impact_of(Seed, C) :- impact_of(Seed, B), calls(C, B).    % ...transitively

%% reach_of(Seed, C)  transitive callees. SEED THE 1st ARG.
reach_of(Seed, C) :- calls(Seed, C).                      % what Seed calls
reach_of(Seed, C) :- reach_of(Seed, B), calls(B, C).

%% impact_of_exact(Seed, C)  impact_of, SCIP-resolved only. SEED THE 1st ARG.
impact_of_exact(Seed, C) :- calls_exact(C, Seed).
impact_of_exact(Seed, C) :- impact_of_exact(Seed, B), calls_exact(C, B).

% === transitive closure, UNSEEDED ======================================
% Whole-graph questions only. On a large repo these are O(n^2) and will hit
% max_derived_tuples; that is the honest cost of asking about every pair.

%% reaches(A, B)  UNSEEDED all-pairs. Expensive.
reaches(A, B) :- calls(A, B).
reaches(A, C) :- reaches(A, B), calls(B, C).
%% recursive(S)  S is on a call cycle. UNSEEDED.
recursive(S) :- reaches(S, S).

% === location helpers ==================================================
%% file_of(S, F)  the file S is defined in.
file_of(S, F) :- def(S, F, _, _).
% `defines(F, S)` was here until schema 2: `file_of` with the arguments the
% other way, and Datalog does not need a second spelling to bind either one.
%% at(S, F, L)  where S starts: file and first line.
at(S, F, L) :- def(S, F, _, _), def_span(S, L, _, _, _).

% === containment closure ===============================================
% within(Child, Ancestor). The argument order is parent's, and an agent reading
% only a signature has to be told which is which — one M1 eval sample reversed
% it (docs/agent-eval.md).
%% within(Child, Ancestor)  transitive containment. Child is FIRST.
within(C, P) :- parent(C, P).
within(C, A) :- parent(C, P), within(P, A).

% === tests =============================================================
% `file(F, _)` is not decoration: without it F is a head variable bound only by
% a filter, which violates range restriction exactly as symbol_at would.
%% is_test(F)  test file, by path or SCIP role.
is_test(F) :- file(F, _), match(F, "(^|/)tests?/").
is_test(F) :- file(F, _), match(F, "_test\\.(go|py|rs)$").
is_test(F) :- file(F, _), match(F, "(^|/)test_[^/]*\\.py$").
is_test(F) :- file(F, _), match(F, "\\.(test|spec)\\.(ts|tsx|js|jsx)$").
is_test(F) :- scip_ref(_, F, _, _, _, "test").

% === orientation: everything about one symbol, in one round trip =======
% Heterogeneous rows sharing a discriminator column. One query instead of six,
% and the definition of "orientation" stays editable.

%% about(S, Rel, A, B, L)  all of S in one trip. Rel = sig|doc|defined|parent|caller|
%%   callee|implements|implementor|test|extern
about(S, "sig",         Sig, "", 0) :- def_sig(S, Sig).
about(S, "doc",         Doc, "", 0) :- def_doc(S, Doc).
about(S, "defined",     F,   N,  L) :- def(S, F, _, N), at(S, F, L).
about(S, "parent",      F,   N,  L) :- parent(S, P), def(P, F, _, N), at(P, F, L).
about(S, "caller",      F,   N,  L) :- calls(C, S), def(C, F, _, N), at(C, F, L).
about(S, "callee",      F,   N,  L) :- calls(S, C), def(C, F, _, N), at(C, F, L).
about(S, "implements",  F,   N,  L) :- implements(S, T, _), def(T, F, _, N), at(T, F, L).
about(S, "implementor", F,   N,  L) :- implements(T, S, _), def(T, F, _, N), at(T, F, L).
about(S, "test",        F,   N,  L) :- calls(C, S), def(C, F, _, N), is_test(F), at(C, F, L).
about(S, "extern",      P,   V,  0) :- extern(S, _, P, V).

% === file-level dependency =============================================
%% depends(F, G)  F references something defined in G.
depends(F, G) :- ref(S, F, _, _, _, _, _), def(S, G, _, _), F != G.

% === the dex "34 methods", as rules ====================================
% `dead_export` over a `name`-provenance graph OVER-REPORTS: an unresolved call
% is an invisible call. `entrypoint` does not degrade, it INVERTS — which is why
% every contaminated rule below ships in an `_exact` form too.

% `def(S, F, _, _)` is what binds F. Written as 01-facts.md had it —
% `ref_outside(S, F) :- ref(S, G, ...), G != F.` — F appears in the head and
% only in a comparison, so the rule is not range-restricted and the engine
% rejects its own standard library. F is always S's defining file at every call
% site, so naming that is both the fix and the honest reading.
%% dead_export(S)  exported, unreferenced elsewhere. OVER-reports on name.
dead_export(S) :- exported(S), def(S, F, _, _), !ref_outside(S, F).
%% ref_outside(S, F)  helper for dead_export.
ref_outside(S, F) :- def(S, F, _, _), ref(S, G, _, _, _, _, _), G != F.

%% entrypoint(S)  a callable nothing calls. INVERTS on name provenance.
entrypoint(S) :- def(S, _, K, _), callable(K), !calls(_, S).

%% def_lines(S, N)  how many lines S spans. Pick your own threshold.
def_lines(S, N) :- def_span(S, A, B, _, _), N = B - A.

%% long_def(S)  spans more than 80 lines. The 80 is FIXED -- use def_lines.
long_def(S) :- def_lines(S, N), N > 80.

%% undocumented_export(S)  exported with no doc comment.
undocumented_export(S) :- exported(S), !def_doc(S, _).

%% uses_package(F, P)  F references external package P.
uses_package(F, P) :- ref(S, F, _, _, _, _, _), extern(S, _, P, _).

% === the precise forms =================================================
%% dead_export_exact(S)  dead_export, SCIP-resolved refs only.
dead_export_exact(S) :- exported(S), resolved(S), def(S, F, _, _),
                        !ref_outside_exact(S, F).
%% ref_outside_exact(S, F)  ref_outside, SCIP-resolved refs only.
ref_outside_exact(S, F) :- def(S, F, _, _), ref(S, G, _, _, _, _, "exact"), G != F.

%% entrypoint_exact(S)  entrypoint, SCIP-resolved calls only.
entrypoint_exact(S) :- def(S, _, K, _), callable(K), resolved(S),
                       !calls_exact(_, S).
%% depends_exact(F, G)  depends, SCIP-resolved refs only.
depends_exact(F, G) :- ref(S, F, _, _, _, _, "exact"), def(S, G, _, _), F != G.
%% uses_package_exact(F, P)  uses_package, SCIP-resolved refs only.
uses_package_exact(F, P) :- ref(S, F, _, _, _, _, "exact"), extern(S, _, P, _).
